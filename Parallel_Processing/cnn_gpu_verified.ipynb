   "source": [
    "# GPU Verification Setup\n",
    "import tensorflow as tf\n",
    "\n",
    "# List all physical GPUs\n",
    "gpus = tf.config.list_physical_devices('GPU')\n",
    "print(f\"Physical GPUs available: {len(gpus)}\")\n",
    "for i, gpu in enumerate(gpus):\n",
    "    print(f\"GPU {i}: {gpu.name}\")\n",
    "\n",
    "# Initialize distributed strategy\n",
    "strategy = tf.distribute.MirroredStrategy()\n",
    "print(f\"\\nNumber of devices in strategy: {strategy.num_replicas_in_sync}\")\n",
    "\n",
    "# GPU monitoring callback\n",
    "class GPUCallback(tf.keras.callbacks.Callback):\n",
    "    def on_epoch_begin(self, epoch, logs=None):\n",
    "        local_devices = tf.config.list_logical_devices('GPU')\n",
    "        print(f\"Epoch {epoch+1} - Using {len(local_devices)} GPU(s)\")\n",
    "        \n",
    "    def on_train_batch_begin(self, batch, logs=None):\n",
    "        if batch % 100 == 0:\n",
    "            from tensorflow.python.client import device_lib\n",
    "            devices = device_lib.list_local_devices()\n",
    "            gpus = [d for d in devices if d.device_type == 'GPU']\n",
    "            print(f\"Batch {batch} - Active GPUs: {len(gpus)}\")"
   ]
  },
